# Byte-compiled / optimised / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging - always regenerable via tools\build_release.bat
build/
dist/
*.egg-info/
.eggs/

# PyInstaller writes its work folder next to the spec; never commit it
*.manifest
*.pkg

# The window icon is generated by tools\make_icon.py, not authored by hand.
# It is checked in deliberately (a fresh clone must be able to build without
# running the generator first), but the line below documents the alternative.
# packaging/pongpro.ico

# Virtual environments
.venv/
venv/
ENV/

# Screenshots are rendered on demand by tools\shots.py
tools/shots/

# Scratch directories left behind by one-off investigations
.scratch*/
.sdlhome/

# Editor / OS noise
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# Local logs written next to a frozen build
*.log
