# Byte-compiled / optimised files
__pycache__/
*.pyc
*.pyo
*$py.class
# NOTE: deliberately NOT "*.py[cod]". That looks like the same thing, but the
# bracket also matches ".pyd" - the compiled C extension modules a frozen
# interpreter loads at run time (_socket, _ctypes, numpy/_multiarray_umath...).
# Git silently drops them, so the pushed build boots on the build machine and
# dies elsewhere with "No module named '_socket'". Keep ".pyd" committable.

# Distribution / packaging - always regenerable via tools\build_release.bat
build/
dist/
*.egg-info/
.eggs/

# PyInstaller writes its work folder next to the spec; never commit it
*.manifest
*.pkg

# The window icon is generated by tools\make_icon.py, not authored by hand.
# It is checked in deliberately (a fresh clone must be able to build without
# running the generator first), but the line below documents the alternative.
# packaging/pongpro.ico

# Virtual environments
.venv/
venv/
ENV/

# Screenshots are rendered on demand by tools\shots.py
tools/shots/

# Scratch directories left behind by one-off investigations
.scratch*/
.sdlhome/

# Editor / OS noise
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# Local logs written next to a frozen build
*.log
